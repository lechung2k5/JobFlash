# ==============================================================================
# JOBFLASH - ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL 15 + PostGIS)
# Cổng 5499 theo docker-compose.yml để tránh đụng độ các service khác
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5499
DB_USERNAME=postgres
DB_PASSWORD=mysecretpassword
DB_DATABASE=gigapp_db
DATABASE_URL=postgresql://postgres:mysecretpassword@localhost:5499/gigapp_db?schema=public

# ------------------------------------------------------------------------------
# 3. REDIS CONFIGURATION (Cache, Geohash & Socket.io Adapter)
# Cổng 6389 để tránh đụng độ cổng Redis mặc định
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6389
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 4. JWT & AUTHENTICATION SECRETS
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_jobflash_2026
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_jobflash_2026
JWT_REFRESH_EXPIRES_IN=30d

# ------------------------------------------------------------------------------
# 5. AWS S3 / CLOUDFLARE R2 (Lưu trữ ảnh CCCD, ảnh Chat, ảnh Nghiệm thu)
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your_aws_or_r2_access_key
AWS_SECRET_ACCESS_KEY=your_aws_or_r2_secret_key
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET_NAME=jobflash-storage
AWS_S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com # Bỏ trống nếu dùng AWS S3 chuẩn
AWS_S3_PUBLIC_CDN_URL=https://cdn.jobflash.vn # Domain public để client load ảnh

# ------------------------------------------------------------------------------
# 6. IN-APP AUDIO CALL & WEBRTC (Gọi điện trực tiếp qua App khi có mạng)
# Tùy chọn 1: Dùng Agora Audio SDK
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate

# Tùy chọn 2: Dùng LiveKit WebRTC (hoặc STUN/TURN server tự dựng)
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=wss://your-livekit-server.com

# ------------------------------------------------------------------------------
# 7. SMS / OTP GATEWAY (Xác thực số điện thoại thực tế)
# ------------------------------------------------------------------------------
# Twilio / Zalo ZNS / SpeedSMS
SMS_PROVIDER=mock # Đổi thành twilio / zalo_zns khi lên production
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ------------------------------------------------------------------------------
# 8. VIETQR & BANKING WEBHOOK (Thu 10% hoa hồng & Tự động mở khóa App)
# ------------------------------------------------------------------------------
BANK_NAME=MBBank # Ngân hàng nhận nộp hoa hồng
BANK_ACCOUNT_NO=0912345678
BANK_ACCOUNT_HOLDER=CONG TY JOBFLASH VIET NAM
VIETQR_CLIENT_ID=your_vietqr_client_id
VIETQR_API_KEY=your_vietqr_api_key
VIETQR_WEBHOOK_SECRET=your_webhook_secret_signature

# ------------------------------------------------------------------------------
# 9. OPENSTREETMAP & OSRM
# ------------------------------------------------------------------------------
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSRM_ROUTING_URL=https://router.project-osrm.org

# ------------------------------------------------------------------------------
# 10. MOBILE APP (EXPO) CLIENT VARIABLES (Cấu hình chung tại .env gốc)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_GOONG_API_KEY=your_goong_api_key_here
EXPO_PUBLIC_GOONG_MAPTILES_KEY=your_goong_maptiles_key_here
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
